{
  "name": "@vcueto/agent-viz",
  "version": "0.12.2",
  "description": "Real-time visualizer for Claude Code and GitHub Copilot CLI sessions: live event stream, token tracking, multi-agent topology with per-source badges, plus a token observatory built on the bundled netgain analysis engine.",
  "bin": {
    "agent-viz": "bin/agent-viz.js",
    "netgain": "netgain/dist/cli.js",
    "netgain-map": "netgain/dist/mcp/main.js"
  },
  "main": "lib/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsx": "^4.20.0",
    "vitest": "^3.2.0"
  },
  "files": [
    "bin/",
    "lib/",
    "public/",
    "netgain/dist/",
    "netgain/package.json",
    "netgain/LICENSE",
    "index.html",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/agent-viz.js start --foreground",
    "stop": "node bin/agent-viz.js stop",
    "status": "node bin/agent-viz.js status",
    "build": "tsc -p netgain/tsconfig.build.json",
    "test": "node --test \"tests/**/*.test.*\"",
    "test:engine": "vitest run --root netgain",
    "typecheck:engine": "tsc --noEmit -p netgain/tsconfig.json",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm run test:engine && npm test && npm pack --dry-run"
  },
  "keywords": [
    "claude-code",
    "claude",
    "copilot",
    "github-copilot",
    "copilot-cli",
    "visualizer",
    "hooks",
    "agent",
    "multi-agent",
    "observability",
    "dashboard",
    "sse",
    "tracing"
  ],
  "author": "pitchan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pitchan/agent-viz.git"
  },
  "bugs": {
    "url": "https://github.com/pitchan/agent-viz/issues"
  },
  "homepage": "https://github.com/pitchan/agent-viz#readme",
  "publishConfig": {
    "access": "public"
  }
}
