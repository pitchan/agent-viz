{
  "name": "@vcueto/agent-viz",
  "version": "0.45.2",
  "description": "Where do your tokens go? One command, zero runtime dependencies: agent-viz tracks your coding agents live (Claude Code, GitHub Copilot CLI, Antigravity CLI) and puts a measured figure on what they waste.",
  "bin": {
    "agent-viz": "bin/agent-viz.js",
    "netgain": "dist/engine/cli.js"
  },
  "main": "dist/server/server.js",
  "type": "module",
  "engines": {
    "node": ">=24.16.0 <25 || >=26.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "vitest": "^3.2.0"
  },
  "files": [
    "bin/agent-viz.js",
    "bin/agent-viz.js.map",
    "dist/server/",
    "src/web/",
    "src/engine/core/tool-subject.ts",
    "src/engine/core/clock-time.ts",
    "src/engine/core/usage.ts",
    "dist/engine/",
    "docs/netgain.md",
    "index.html",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/agent-viz.js start --foreground",
    "stop": "node bin/agent-viz.js stop",
    "status": "node bin/agent-viz.js status",
    "build": "node -e \"['dist/engine','dist/server','bin/agent-viz.js'].forEach(d=>require('fs').rmSync(d,{recursive:true,force:true}))\" && tsc -b tsconfig.build.json && tsc -p tsconfig.bin.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run build && npm test && npm pack --dry-run"
  },
  "keywords": [
    "claude-code",
    "claude",
    "copilot",
    "github-copilot",
    "copilot-cli",
    "antigravity",
    "antigravity-cli",
    "token-usage",
    "cost-tracking",
    "visualizer",
    "hooks",
    "agent",
    "multi-agent",
    "observability",
    "dashboard",
    "sse",
    "tracing"
  ],
  "author": "pitchan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pitchan/agent-viz.git"
  },
  "bugs": {
    "url": "https://github.com/pitchan/agent-viz/issues"
  },
  "homepage": "https://github.com/pitchan/agent-viz#readme",
  "publishConfig": {
    "access": "public"
  }
}
