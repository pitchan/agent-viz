{
  "name": "@vcueto/agent-viz",
  "version": "0.14.0",
  "description": "Real-time visualizer for Claude Code and GitHub Copilot CLI sessions: live event stream, token tracking, multi-agent topology with per-source badges, plus a token observatory built on the bundled netgain analysis engine.",
  "bin": {
    "agent-viz": "bin/agent-viz.js",
    "netgain": "dist/engine/cli.js",
    "netgain-map": "dist/engine/mcp/main.js"
  },
  "main": "src/server/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsx": "^4.20.0",
    "vitest": "^3.2.0"
  },
  "files": [
    "bin/",
    "src/server/",
    "src/web/",
    "dist/engine/",
    "docs/netgain.md",
    "index.html",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/agent-viz.js start --foreground",
    "stop": "node bin/agent-viz.js stop",
    "status": "node bin/agent-viz.js status",
    "build": "tsc -p tsconfig.node.build.json && node scripts/dist-esm-marker.mjs",
    "test": "vitest run",
    "test:node": "node --test \"tests/**/*.test.{cjs,js,mjs}\"",
    "test:ids:node": "node --test --test-reporter=./test-support/ids/node-reporter.mjs \"tests/**/*.test.{cjs,js,mjs}\"",
    "typecheck:engine": "tsc --noEmit -p tsconfig.node.json",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm test && npm run test:node && npm pack --dry-run"
  },
  "keywords": [
    "claude-code",
    "claude",
    "copilot",
    "github-copilot",
    "copilot-cli",
    "visualizer",
    "hooks",
    "agent",
    "multi-agent",
    "observability",
    "dashboard",
    "sse",
    "tracing"
  ],
  "author": "pitchan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pitchan/agent-viz.git"
  },
  "bugs": {
    "url": "https://github.com/pitchan/agent-viz/issues"
  },
  "homepage": "https://github.com/pitchan/agent-viz#readme",
  "publishConfig": {
    "access": "public"
  }
}
