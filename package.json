{
  "name": "@vcueto/agent-viz",
  "version": "0.39.0",
  "description": "Real-time visualizer for Claude Code and GitHub Copilot CLI sessions: live event stream, token tracking, multi-agent topology with per-source badges, plus a token observatory built on the bundled netgain analysis engine.",
  "bin": {
    "agent-viz": "bin/agent-viz.js",
    "netgain": "dist/engine/cli.js"
  },
  "main": "dist/server/server.js",
  "type": "module",
  "engines": {
    "node": ">=24.16.0 <25 || >=26.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "vitest": "^3.2.0"
  },
  "files": [
    "bin/",
    "dist/server/",
    "src/web/",
    "src/engine/core/tool-subject.ts",
    "src/engine/core/clock-time.ts",
    "src/engine/core/usage.ts",
    "dist/engine/",
    "docs/netgain.md",
    "index.html",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/agent-viz.js start --foreground",
    "stop": "node bin/agent-viz.js stop",
    "status": "node bin/agent-viz.js status",
    "build": "node -e \"['dist/engine','dist/server'].forEach(d=>require('fs').rmSync(d,{recursive:true,force:true}))\" && tsc -b tsconfig.build.json",
    "test": "vitest run",
    "test:node": "node --import ./test-support/env-guard.mjs --test \"tests/**/*.test.{cjs,mjs}\"",
    "test:ids:node": "node --import ./test-support/env-guard.mjs --test --test-reporter=./test-support/ids/node-reporter.mjs \"tests/**/*.test.{cjs,mjs}\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run build && npm test && npm run test:node && npm pack --dry-run"
  },
  "keywords": [
    "claude-code",
    "claude",
    "copilot",
    "github-copilot",
    "copilot-cli",
    "visualizer",
    "hooks",
    "agent",
    "multi-agent",
    "observability",
    "dashboard",
    "sse",
    "tracing"
  ],
  "author": "pitchan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pitchan/agent-viz.git"
  },
  "bugs": {
    "url": "https://github.com/pitchan/agent-viz/issues"
  },
  "homepage": "https://github.com/pitchan/agent-viz#readme",
  "publishConfig": {
    "access": "public"
  }
}
