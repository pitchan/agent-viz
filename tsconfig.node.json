{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": false,
    "outDir": "dist/engine",
    "types": ["node"]
  },
  // Ce projet sert au TYPECHECK, pas a l emission : `npm run typecheck:engine` le lance
  // avec --noEmit. L emission passe par tsconfig.node.build.json, qui REMPLACE cet
  // include par ["src/engine/**/*.ts"] et FIXE rootDir: "src/engine".
  // Mesure (tsc 5.9.3) : sans ce couple, ajouter tests/**/*.ts ici deplace TOUTES les
  // sorties (dist/engine/cli.js -> dist/engine/src/engine/core/cli.js) et fait entrer
  // l arbre de tests dans dist/engine/. Ce projet n a pas de rootDir : c est deliberé
  // tant qu il n emet pas.
  // ETAPE 4 : doc/36 fait de ce projet celui de src/server + src/engine, et npm run
  // build devient `tsc -b`. Il faudra alors POSER un rootDir, ou sortir tests/** du
  // projet d emission. A trancher a l etape 4, pas ici.
  "include": ["src/engine/**/*.ts", "tests/**/*.ts", "vitest.config.mts"]
}
